# Copie para .env.local (ignorado pelo git). Nenhuma chave e obrigatoria: sem ela, o site usa
# GitHub REST publico (60 req/h, com cache) e mostra o calendario de commits em modo demo.

# Token pessoal do GitHub, escopo read:user (opcional). Habilita GraphQL: calendario de
# contribuicoes real e total de stars.
VITE_GITHUB_TOKEN=

# Server-side (Vercel Functions), nao lidas pelo client:
# GROQ_API_KEY=      -> api/chat.ts
# RESEND_API_KEY=    -> api/contact.ts
