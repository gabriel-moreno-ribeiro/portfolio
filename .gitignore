# Politica (set/2026, pedido do Gabriel): tudo que esta na pasta vai para o GitHub.
# Ficam de fora so: segredos, o que se regenera sozinho, estado local de
# ferramentas e clones de repositorios de terceiros.

# dependencias (regeneradas por npm install)
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# build (regenerado por npm run build)
/dist
*.tsbuildinfo

# misc
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# segredos: nunca num repositorio publico
.env
.env*
!.env.example
*.local

# estado local de ferramentas (especifico da maquina, pode guardar token)
.vercel
.gstack/
.wrangler/
/.letta

# clones de repositorios de terceiros (tem git proprio)
/tools
/.claude/refs

# skills de design de terceiros (60 MB). Reinstalar na raiz do projeto:
#   npx skills add nutlope/hallmark cathrynlavery/diagram-design bklit/bklit-ui --agent claude-code -y
#   npx skills add https://github.com/Leonxlnx/taste-skill --skill design-taste-frontend --agent claude-code -y
#   npx impeccable install -y --providers=claude --project
#   npx ui-ux-pro-max-cli init --ai claude
/.claude/skills/

# estado local do verificador de design (impeccable); a config compartilhada vai para o git
/.impeccable/hook.cache.json

# saídas de QA, capturas e rascunhos de agentes: não vão para o git
/qa/
/overnight/
/.playwright-cli/
/screenshots/
