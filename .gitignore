# Politica (set/2026, pedido do Gabriel): tudo que esta na pasta vai para o GitHub.
# Ficam de fora so: segredos, o que se regenera sozinho, estado local de
# ferramentas e clones de repositorios de terceiros.

# dependencias (regeneradas por npm install)
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# build (regenerado por npm run build)
/dist
*.tsbuildinfo

# misc
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# segredos: nunca num repositorio publico
.env
.env*
!.env.example
*.local

# estado local de ferramentas (especifico da maquina, pode guardar token)
.vercel
.gstack/
.wrangler/
/.letta

# clones de repositorios de terceiros (tem git proprio)
/tools
/.claude/refs
